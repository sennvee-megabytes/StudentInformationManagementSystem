# Database (Neon Lakebase Postgres): pooled for runtime, unpooled for migrations
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Neon Branch & Object Storage (injected automatically by `neon deploy` / `neon env pull`)
NEON_BRANCH="production"
NEON_BRANCH_ID="br-xxxx"
AWS_ACCESS_KEY_ID="your-neon-storage-access-key"
AWS_SECRET_ACCESS_KEY="your-neon-storage-secret-key"
AWS_ENDPOINT_URL_S3="https://br-xxxx.ap-southeast-1.storage.neon.tech"
AWS_REGION="ap-southeast-1"

# Application
NODE_ENV="production"
APP_URL="https://your-app.vercel.app"
FEATURE_ACADEMIC_RECORDS="true"

# Cron protection (Vercel sends this as a Bearer token to cron paths)
CRON_SECRET="generate-a-long-random-string"

# One-time seed (use locally, remove from Vercel after seeding)
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="choose-a-strong-temporary-password"
SEED_DEMO_DATA="false"
